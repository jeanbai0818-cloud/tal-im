{
  "name": "yach-tal-im",
  "version": "2026.5.13-4",
  "private": true,
  "description": "TAL 知音楼（Yach）新架构插件 — core/personal/robot 三层结构",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && openclaw plugins install . --force"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "devDependencies": {
    "openclaw": "latest",
    "typescript": "^5.9.3"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.5.0",
      "minGatewayVersion": "2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.5.7"
    },
    "extensions": ["./dist/index.js"],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "yach",
      "label": "TAL 知音楼（好未来企业 IM）",
      "selectionLabel": "TAL 知音楼（好未来企业 IM）",
      "blurb": "好未来（TAL）企业 IM 知音楼，支持数字伙伴机器人、流式 AI 回复及主动消息推送（文本、图片、文件、视频）。",
      "docsPath": "/channels/yach",
      "order": 80
    },
    "install": {
      "npmSpec": "yach",
      "localPath": ".",
      "defaultChoice": "local"
    }
  }
}
